{% extends 'base.html.twig' %}

{% block title %}Manage Software Versions{% endblock %}

{% block body %}
    <div class="card">
        <h1>Software Versions</h1>
        <p><a class="button" href="{{ path('admin_software_versions_new') }}">Add new</a></p>
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Version</th>
                <th>Version Alt</th>
                <th>Latest</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.id }}</td>
                    <td>{{ item.name }}</td>
                    <td>{{ item.systemVersion }}</td>
                    <td>{{ item.systemVersionAlt }}</td>
                    <td>{{ item.latest ? 'Yes' : 'No' }}</td>
                    <td>
                        <a class="button" href="{{ path('admin_software_versions_edit', {id: item.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_software_versions_delete', {id: item.id}) }}" style="display:inline;">
                            <button class="danger" type="submit" onclick="return confirm('Delete this record?')">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">No records found.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
